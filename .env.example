# Daily puzzle HMAC secret for production deployment.
# 
# Three modes:
# 1. Development (NODE_ENV != 'production', secret unset):
#    - Date gating disabled; all dates accessible
#    - Response includes full answer for QA
#    - Cache-Control: no-store
#
# 2. Development with secret (NODE_ENV != 'production', secret set):
#    - Date gating enabled; future dates rejected with 400
#    - Response includes full answer for QA
#    - Cache-Control: no-store
#
# 3. Production (NODE_ENV='production', secret set):
#    - Date gating enabled; future dates rejected with 400
#    - Response omits answer field; only clues served
#    - Cache-Control: s-maxage until UTC midnight (today) or max-age=3600 (past)
#
# CRITICAL: If NODE_ENV='production' and this is unset, the route handler fails closed
# with HTTP 500 to prevent accidental answer leakage.
LOST_EXPLORER_DAILY_SECRET=
